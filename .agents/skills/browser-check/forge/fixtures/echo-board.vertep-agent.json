{
  "format": "vertep-canvas",
  "version": 1,
  "kind": "agent",
  "title": "Echo board",
  "nodes": [
    {
      "id": "in",
      "type": "agent.input",
      "x": 10,
      "y": 100,
      "title": "Input",
      "params": {
        "give": [
          {
            "id": "reply",
            "source": "lastReply"
          }
        ]
      }
    },
    {
      "id": "ask",
      "type": "model.ask",
      "x": 250,
      "y": 100,
      "title": "Say it",
      "params": {
        "role": "fast",
        "prompt": "FORGE-ECHO: say one line about this scene.\n\n{{reply}}",
        "answer": {
          "as": "text"
        },
        "maxTokens": 120,
        "batchKey": null
      }
    },
    {
      "id": "set",
      "type": "state.set",
      "x": 500,
      "y": 100,
      "title": "Keep it",
      "params": {
        "field": "said",
        "as": "text"
      }
    },
    {
      "id": "out",
      "type": "agent.output",
      "x": 750,
      "y": 100,
      "title": "Output",
      "params": {
        "kind": "state-patch",
        "show": "float"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "in:reply",
      "to": "ask:reply"
    },
    {
      "id": "e2",
      "from": "ask:text",
      "to": "set:value"
    },
    {
      "id": "e3",
      "from": "set:done",
      "to": "out:in"
    }
  ],
  "agent": {
    "formatVersion": 1,
    "id": "echo-board",
    "version": "1.0.0",
    "name": "Echo board",
    "description": "Writes one line the model made into a panel. Used by the Forge checks.",
    "author": "forge-check",
    "trigger": {
      "when": "after",
      "everyN": 1,
      "keywords": []
    },
    "models": {
      "fast": {
        "hint": "cheap, short answers"
      }
    },
    "limits": {
      "maxCalls": 1,
      "concurrency": 1
    },
    "state": {
      "said": {
        "type": "text"
      }
    },
    "panels": [
      {
        "id": "board",
        "title": "Echo",
        "place": "float",
        "widgets": [
          {
            "w": "html",
            "bind": "said",
            "height": 140,
            "template": "<div style=\"padding:6px;border:1px solid #888\"><b>Said:</b> <span>{{said}}</span> <i>{{#if said}}(set){{/if}}</i></div>"
          },
          {
            "w": "text",
            "label": "Plain",
            "bind": "said"
          }
        ]
      }
    ],
    "derived": {
      "needs": [
        "llm",
        "read:lastReply",
        "show:panel",
        "write:own.said"
      ],
      "maxCalls": 1,
      "hash": "sha256:7e2ef303ffa3f77759fa5487f28aab11441a05b4612bcaa8e980d9baef61c446"
    }
  }
}
